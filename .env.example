
# PostgreSQL - Docker
POSTGRES_USER=myuser
POSTGRES_PASSWORD=change_me
POSTGRES_DB=mediguard_db

# Prisma
DATABASE_URL="postgresql://myuser:change_me@localhost:5432/mediguard_db?schema=public"

# Authentication
JWT_SECRET=replace_with_a_random_secret

# Web Push
NEXT_PUBLIC_VAPID_PUBLIC_KEY=replace_with_your_public_key
VAPID_PRIVATE_KEY=replace_with_your_private_key
VAPID_SUBJECT=mailto:example@example.com
